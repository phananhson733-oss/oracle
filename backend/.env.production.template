# ============================================================
# AstrologyWiki — Production Environment Variables
# ============================================================
# 使用说明:
#   1. 复制此文件并重命名为 .env（本地）或配置到 Vercel Dashboard
#   2. 替换所有 <REPLACE_...> 占位符为真实值
#   3. 支付服务仅使用 Airwallex（已移除 PayPal / Stripe）
# ============================================================

# -------------------- Server --------------------
PORT=3001
NODE_ENV=production

# -------------------- AI Service (DeepSeek) --------------------
DEEPSEEK_API_KEY=<REPLACE_DEEPSEEK_API_KEY>
DEEPSEEK_BASE_URL=https://api.deepseek.com

# -------------------- Database (Supabase) --------------------
SUPABASE_URL=<REPLACE_SUPABASE_URL>
SUPABASE_SERVICE_ROLE_KEY=<REPLACE_SUPABASE_SERVICE_ROLE_KEY>
# 直连数据库（可选，用于迁移脚本等）
# SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require

# -------------------- JWT Authentication --------------------
# 必须替换！用 `openssl rand -base64 64` 生成高强度密钥
JWT_SECRET=<REPLACE_JWT_SECRET>

# -------------------- Payment: Airwallex (Production) --------------------
PAYMENT_PROVIDER=airwallex
AIRWALLEX_ENVIRONMENT=production
AIRWALLEX_CLIENT_ID=<REPLACE_AIRWALLEX_CLIENT_ID>
AIRWALLEX_API_KEY=<REPLACE_AIRWALLEX_API_KEY>
AIRWALLEX_WEBHOOK_SECRET=<REPLACE_AIRWALLEX_WEBHOOK_SECRET>
AIRWALLEX_LEGAL_ENTITY_ID=<REPLACE_AIRWALLEX_LEGAL_ENTITY_ID>
AIRWALLEX_PAYMENT_ACCOUNT_ID=

# Airwallex 产品 ID（在正式环境 Dashboard 中创建）
AIRWALLEX_PRODUCT_SUBSCRIPTION=<REPLACE_AIRWALLEX_PRODUCT_ID>

# Airwallex 价格 ID — USD
AIRWALLEX_PRICE_MONTHLY_USD=<REPLACE_PRICE_ID>
AIRWALLEX_PRICE_YEARLY_USD=<REPLACE_PRICE_ID>
AIRWALLEX_PRICE_MONTHLY_FIRST_USD=<REPLACE_PRICE_ID>
AIRWALLEX_PRICE_YEARLY_FIRST_USD=<REPLACE_PRICE_ID>

# Airwallex 价格 ID — CNY
AIRWALLEX_PRICE_MONTHLY_CNY=<REPLACE_PRICE_ID>
AIRWALLEX_PRICE_YEARLY_CNY=<REPLACE_PRICE_ID>
AIRWALLEX_PRICE_MONTHLY_FIRST_CNY=<REPLACE_PRICE_ID>
AIRWALLEX_PRICE_YEARLY_FIRST_CNY=<REPLACE_PRICE_ID>

# -------------------- Google OAuth --------------------
GOOGLE_CLIENT_ID=<REPLACE_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<REPLACE_GOOGLE_CLIENT_SECRET>

# -------------------- Apple Sign-In (Optional) --------------------
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# -------------------- Email Service (Resend) --------------------
RESEND_API_KEY=<REPLACE_RESEND_API_KEY>
RESEND_FROM_EMAIL=AstrologyWiki <noreply@astrologywiki.com>

# -------------------- Redis Cache (Optional) --------------------
# 不配置则使用内存缓存，正式环境建议配置
# REDIS_URL=redis://<host>:6379

# -------------------- GM Commands --------------------
# 正式环境必须保持关闭！
# ENABLE_GM_COMMANDS=false
