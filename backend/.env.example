# AstroMind AI Backend Environment Variables

# Server
PORT=3001

# AI API (DeepSeek)
DEEPSEEK_API_KEY=your_deepseek_api_key

# Supabase Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Stripe Payment (Legacy - 保留用于迁移)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard)
STRIPE_PRICE_MONTHLY=price_monthly_699
STRIPE_PRICE_YEARLY=price_yearly_4999
STRIPE_PRICE_DIMENSION=price_dimension_99
STRIPE_PRICE_CORE_THEME=price_core_theme_99
STRIPE_PRICE_DAILY_SCRIPT=price_daily_script_99
STRIPE_PRICE_DAILY_TRANSIT=price_daily_transit_99
STRIPE_PRICE_DETAIL_VIEW=price_detail_view_99
STRIPE_PRICE_SYNASTRY=price_synastry_299
STRIPE_PRICE_SYNASTRY_DETAIL=price_synastry_detail_99
STRIPE_PRICE_ASK=price_ask_199
STRIPE_PRICE_CBT_STATS=price_cbt_stats_199
STRIPE_PRICE_DETAIL_PACK=price_detail_299
STRIPE_PRICE_CBT=price_cbt_99
STRIPE_PRICE_REPORT_MONTHLY=price_report_monthly_199
STRIPE_PRICE_REPORT_ANNUAL=price_report_annual_799
STRIPE_PRICE_REPORT_CAREER=price_report_career_499
STRIPE_PRICE_REPORT_WEALTH=price_report_wealth_499
STRIPE_PRICE_REPORT_LOVE=price_report_love_499
STRIPE_PRICE_REPORT_SATURN=price_report_saturn_699

# PayPal Payment (推荐 - 支持中国企业账户)
# 获取方式: https://developer.paypal.com/dashboard/applications/live
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Mode: sandbox (测试环境) 或 live (生产环境)
PAYPAL_MODE=sandbox
# Webhook ID: 在 PayPal Dashboard 创建 Webhook 后获取
PAYPAL_WEBHOOK_ID=your_webhook_id

# PayPal 订阅计划 ID (在 PayPal Dashboard > Products & Plans 创建)
# 标准价格计划
PAYPAL_PLAN_MONTHLY=P-xxxxxxxxxxxxxxxxxxxx
PAYPAL_PLAN_YEARLY=P-xxxxxxxxxxxxxxxxxxxx
# 首次订阅折扣计划 (50% off - 可选)
PAYPAL_PLAN_MONTHLY_FIRST=P-xxxxxxxxxxxxxxxxxxxx
PAYPAL_PLAN_YEARLY_FIRST=P-xxxxxxxxxxxxxxxxxxxx

# PayPal 产品 ID (在 PayPal Dashboard > Products 创建)
PAYPAL_PRODUCT_SUBSCRIPTION=PROD-xxxxxxxxxxxxxxxxxxxx
PAYPAL_PRODUCT_CREDITS=PROD-xxxxxxxxxxxxxxxxxxxx

# Payment Provider Switch (airwallex | stripe | paypal | all)
PAYMENT_PROVIDER=airwallex

# Airwallex Payment (推荐 - 支持全球收款含国内)
# 获取方式: https://www.airwallex.com/app/account/api-keys
AIRWALLEX_CLIENT_ID=your_airwallex_client_id
AIRWALLEX_API_KEY=your_airwallex_api_key
# 环境: demo (测试) 或 production (生产)
AIRWALLEX_ENVIRONMENT=demo
# Webhook 签名密钥: 在 Airwallex Dashboard > Webhooks 创建后获取
AIRWALLEX_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Apple Sign-In (Optional)
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY=your_apple_private_key

# Resend Email Service (for verification codes)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=AstroMind <noreply@astromind.ai>
