# Frontend Environment Variables

# Google OAuth
VITE_GOOGLE_CLIENT_ID=291042741532-kg7kem2gaiged8m9csgjblrp0342tunt.apps.googleusercontent.com

# Apple OAuth (可选)
VITE_APPLE_CLIENT_ID=your.apple.service.id

# Google Analytics 4
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense
# 默认关闭 head-loader，避免首页首字节加载广告脚本；首次审核时临时置 true。
VITE_ADSENSE_HEAD_LOADER_ENABLED=false
# PR1 (plumbing) 默认关闭：全站无广告。PR2 激活时置 true 并填 client/slot。
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# wiki 文末广告位 ID（AdSense 后台创建广告单元后填入）
VITE_ADSENSE_SLOT_WIKI_END=XXXXXXXXXX

# Backend API URL
# 本地开发: http://localhost:3001
# 生产环境: https://your-domain.com (或 https://your-domain.vercel.app)
VITE_API_URL=http://localhost:3001
