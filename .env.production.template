# ============================================================
# AstrologyWiki — Frontend Production Environment Variables
# ============================================================
# 配置到 Vercel Dashboard > Settings > Environment Variables
# Scope: Production
# ============================================================

# -------------------- Backend API --------------------
# Vercel 部署时前端通过 rewrite 访问 /api，无需单独配置
# VITE_API_BASE_URL 留空或不设置，生产环境自动使用 /api
VITE_API_URL=https://www.astrologywiki.com

# -------------------- Google OAuth --------------------
VITE_GOOGLE_CLIENT_ID=<REPLACE_GOOGLE_CLIENT_ID>

# -------------------- Apple OAuth (Optional) --------------------
# VITE_APPLE_CLIENT_ID=

# -------------------- Google Analytics 4 --------------------
VITE_GA4_MEASUREMENT_ID=<REPLACE_GA4_ID>

# -------------------- Google Tag Manager (Optional) --------------------
# VITE_GTM_CONTAINER_ID=GTM-XXXXXXX

# -------------------- Google AdSense --------------------
# 默认关闭 head-loader，避免首页首字节加载广告脚本；首次审核时临时置 true。
VITE_ADSENSE_HEAD_LOADER_ENABLED=false
# PR1（plumbing）阶段保持 false（全站无广告，仅落地基础设施）。
# PR2 激活：置 true + 填 client/slot + AdSense 后台启用 Google CMP + 提交站点审核。
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_CLIENT_ID=<REPLACE_ADSENSE_CLIENT_ID>
# wiki 文末广告位 ID（后台创建广告单元后填入）
VITE_ADSENSE_SLOT_WIKI_END=<REPLACE_ADSENSE_SLOT_WIKI_END>
